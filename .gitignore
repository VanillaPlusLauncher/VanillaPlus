# Built output and downloaded runtime
build/
*.exe

# Dependencies (npm install)
node_modules/

# Minecraft files from Mojang: never committed, the launcher downloads them
src/assets/mc-ui/
# The installer's backgrounds are Minecraft panoramas: made by installer/make-setup-art.ps1 from
# the launcher's cache when a build needs them
installer/art/setup-pano-*.png

# API keys of builds: only ever in the built app
installer/curseforge.key
src/src/build-keys.json
# Token for uploading builds to the launcher's site (installer/publish-site.ps1)
installer/site-token.txt

# Original archive, local logs and working files
/launcher/
/screenshots/
*.log
__pycache__/

# Cloudflare tooling for server/
server/node_modules/
server/.wrangler/
# Exports of the old Cloudflare databases for the move (players' data: never to git); the two
# schemas stay
server/*.sql
!server/schema.sql
!server/files-schema.sql
installer/ely-oauth.json

# Promo video project: frames, renders and the music never go to git
promo-video/

# Local preview setup and scratch pages of the website
.claude/
website/loader-demo.html

# The site's promo videos carry the music: they go to the server, never to git
website/assets/video/

# The game's own textures for the site's start animation: from Mojang, so they go to the
# site's server only, never to git (the owner's decision; geode.js draws stand-ins without them)
website/assets/mc/

# The site's database and unfinished uploads (created by the server, holds the admin's password hash)
website/data/
